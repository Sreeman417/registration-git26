{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitogether26-backend",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  "durable_objects": {
    "bindings": [
      {
        "name": "MONGODB_CONNECTION",
        "class_name": "MongoDBConnection"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MongoDBConnection"]
    }
  ]
}